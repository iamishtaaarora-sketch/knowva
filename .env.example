# ---- Required ----
GROQ_API_KEY=paste_your_groq_api_key_here
# Recommended (production): llama-3.3-70b-versatile  | faster/cheaper: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000

# ---- Optional search providers (leave blank to disable) ----
TAVILY_API_KEY=      # General Web (preferred) https://tavily.com
BRAVE_API_KEY=       # General Web (alternative) https://brave.com/search/api/
YOUTUBE_API_KEY=     # YouTube Data API v3 (Google Cloud Console)
GITHUB_TOKEN=        # optional, raises GitHub rate limits
# Wikipedia, Stack Overflow, Reddit (public JSON) and GitHub need no key.

# Only needed if the frontend is hosted on another origin
CORS_ORIGIN=
